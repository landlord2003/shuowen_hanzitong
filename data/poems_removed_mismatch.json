  "line": "欲穷千里目，更上一层楼。",
  "source": "王之涣·《登鹳雀楼》"
 },
 {
  "char": "婆",
  "line": "舞低杨柳楼心月，歌尽桃花扇底风。",
  "source": "待考"
 },
 {
  "char": "情",
  "line": "感时花溅泪，恨别鸟惊心。",
  "source": "杜甫·《春望》"
 },
 {
  "char": "寇",
  "line": "边城多警急，胡虏数惊扰。",
  "source": "待考"
 },
 {
  "char": "谋",
  "line": "运筹帷幄之中，决胜千里之外。",
  "source": "待考"
 },
 {
  "char": "隅",
  "line": "山光悦鸟性，潭影空人心。",
  "source": "待考"
 },
 {
  "char": "绿",
  "line": "两个黄鹂鸣翠柳，一行白鹭上青天。",
  "source": "杜甫·《绝句》"
 },
 {
  "char": "欠",
  "line": "欲把西湖比西子，淡妆浓抹总相宜。",
  "source": "苏轼·《饮湖上初晴后雨》"
 },
 {
  "char": "欠",
  "line": "山重水复疑无路，柳暗花明又一村。",
  "source": "陆游·《游山西村》"
 },
 {
  "char": "年",
  "line": "爆竹声中一岁除，春风送暖入屠苏。",
  "source": "待考"
 },
 {
  "char": "舌",
  "line": "欲把西湖比西子，淡妆浓抹总相宜。",
  "source": "苏轼·《饮湖上初晴后雨》"
 },
 {
  "char": "朵",
  "line": "桃花乱落如红雨，柳絮纷飞似白烟。",
  "source": "待考"
 },
 {
  "char": "灯",
  "line": "更深月色半人家，北斗阑干南斗斜。",
  "source": "待考"
 },
 {
  "char": "诀",
  "line": "此去泉台招旧部，旌旗十万斩阎罗。",
  "source": "待考"
 },
 {
  "char": "寿",
  "line": "愿得一心人，白头不相离。",
  "source": "待考"
 },
 {
  "char": "寿",
  "line": "人生得意须尽欢，莫使金樽空对月。",
  "source": "待考"
 },
 {
  "char": "麦",
  "line": "春种一粒粟，秋收万颗子。四海无闲田，农夫犹饿死。",
  "source": "待考"
 },
 {
  "char": "远",
  "line": "欲穷千里目，更上一层楼。",
  "source": "王之涣·《登鹳雀楼》"
 },
 {
  "char": "远",
  "line": "海内存知己，天涯若比邻。",
  "source": "王勃·《送杜少府之任蜀州》"
 },
 {
  "char": "韧",
  "line": "千磨万击还坚劲，任尔东西南北风。",
  "source": "待考"
 },
 {
  "char": "孝",
  "line": "哀哀父母，生我劬劳。欲报之德，昊天罔极。",
  "source": "待考"
 },
 {
  "char": "花",
  "line": "春江潮水连海平，海上明月共潮生。",
  "source": "张若虚·《春江花月夜》"
 },
 {
  "char": "助",
  "line": "愿得一心人，白头不相离。",
  "source": "待考"
 },
 {
  "char": "琴",
  "line": "泠泠七弦上，静听松风寒。",
  "source": "待考"
 },
 {
  "char": "喜",
  "line": "爆竹声中一岁除，春风送暖入屠苏。",
  "source": "待考"
 },
 {
  "char": "期",
  "line": "愿得一心人，白头不相离。",
  "source": "待考"
 },
 {
  "char": "期",
  "line": "人生若只如初见，何事秋风悲画扇。",
  "source": "待考"
 },
 {
  "char": "葬",
  "line": "生如夏花之绚烂，死如秋叶之静美。",
  "source": "待考"
 },
 {
  "char": "葱",
  "line": "绿树阴浓夏日长，楼台倒影入池塘。水晶帘动微风起，满架蔷薇一院香。",
  "source": "待考"
 },
 {
  "char": "落",
  "line": "山重水复疑无路，柳暗花明又一村。",
  "source": "陆游·《游山西村》"
 },
 {
  "char": "棋",
  "line": "闲来垂钓碧溪上，忽复乘舟梦日边。行路难！行路难！多歧路，今安在？长风破浪会有时，直挂云帆济沧海。",
  "source": "待考"
 },
 {
  "char": "森",
  "line": "林表明霁色，城中增暮寒。",
  "source": "待考"
 },
 {
  "char": "辈",
  "line": "少小离家老大回，乡音未改鬓毛衰。儿童相见不相识，笑问客从何处来。",
  "source": "待考"
 },
 {
  "char": "践",
  "line": "欲把西湖比西子，淡妆浓抹总相宜。",
  "source": "苏轼·《饮湖上初晴后雨》"
 },
 {
  "char": "践",
  "line": "山重水复疑无路，柳暗花明又一村。",
  "source": "陆游·《游山西村》"
 },
 {
  "char": "牌",
  "line": "山重水复疑无路，柳暗花明又一村。",
  "source": "陆游·《游山西村》"
 },
 {
  "char": "集",
  "line": "群山万壑赴荆门，生长明妃尚有村。",
  "source": "待考"
 },
 {
  "char": "湘",
  "line": "九曲黄河万里沙，浪淘风簸自天涯。",
  "source": "待考"
 },
 {
  "char": "渡",
  "line": "两岸猿声啼不住，轻舟已过万重山。",
  "source": "李白·《早发白帝城》"
 },
 {
  "char": "慌",
  "line": "战战兢兢，如临深渊，如履薄冰。",
  "source": "待考"
 },
 {
  "char": "隔",
  "line": "欲穷千里目，更上一层楼。",
  "source": "王之涣·《登鹳雀楼》"
 },
 {
  "char": "隔",
  "line": "山重水复疑无路，柳暗花明又一村。",
  "source": "陆游·《游山西村》"
 },
 {
  "char": "摸",
  "line": "欲把西湖比西子，淡妆浓抹总相宜。",
  "source": "苏轼·《饮湖上初晴后雨》"
 },
 {
  "char": "酬",
  "line": "醉里挑灯看剑，梦回吹角连营。",
  "source": "辛弃疾·《破阵子·为陈同甫赋壮词以寄之》"
 },
 {
  "char": "鼠",
  "line": "朱门酒肉臭，路有冻死骨。",
  "source": "杜甫·《自京赴奉先县咏怀五百字》"
 },
 {
  "char": "粮",
  "line": "但使龙城飞将在，不教胡马度阴山。",
  "source": "王昌龄·《出塞》"
 },
 {
  "char": "摘",
  "line": "采菊东篱下，悠然见南山。",
  "source": "陶渊明·《饮酒·其五》"
 },
 {
  "char": "瘦",
  "line": "朱雀桥边野草花，乌衣巷口夕阳斜。",
  "source": "待考"
 },
 {
  "char": "漂",
  "line": "孤舟蓑笠翁，独钓寒江雪。",
  "source": "柳宗元·《江雪》"
 },
 {
  "char": "醋",
  "line": "莫笑老翁无用处，一生肝胆付东流。",
  "source": "待考"
 },
 {
  "char": "霄",
  "line": "长风破浪会有时，直挂云帆济沧海。",
  "source": "李白·《行路难·其一》"
 },
 {
  "char": "踪",
  "line": "但见新人笑，也无旧人哭。却把旧人泪，滴作新衣裳。",
  "source": "待考"
 },
 {
  "char": "嘱",
  "line": "临行密密缝，意恐迟迟归。",
  "source": "待考"
 },
 {
  "char": "潮",
  "line": "海日生残夜，江春入旧年。",
  "source": "王湾·《次北固山下》"
 },
 {
  "char": "醒",
  "line": "醉卧沙场君莫笑，古来征战几人回。",
  "source": "待考"
 },
 {
  "char": "餐",
  "line": "饭疏食饮水，曲肱而枕之，乐亦在其中矣。",
  "source": "待考"
 },
 {
  "char": "壁",
  "line": "秦时明月汉时关，万里长征人未还。",
  "source": "待考"
 },
 {
  "char": "霜",
  "line": "草木本有心，何求美人折。",
  "source": "待考"
 },
 {
  "char": "霞",
  "line": "朝辞白帝彩云间，千里江陵一日还。",
  "source": "李白·《早发白帝城》"
 },
 {
  "char": "穗",
  "line": "稻花香里说丰年，听取蛙声一片。",
  "source": "辛弃疾·《西江月·夜行黄沙道中》"
 },
 {
  "char": "阜",
  "line": "山光悦鸟性，潭影空人心。",
  "source": "待考"
 },
 {
  "char": "咎",
  "line": "天作之合，岂人力所能为哉？",
  "source": "待考"
 },
 {
  "char": "诤",
  "line": "愿得一心人，白头不相离。",
  "source": "待考"
 },
 {
  "char": "桉",
  "line": "何以報之靑玉案，謂靑玉椀也",
  "source": "待考"
 },
 {
  "char": "颀",
  "line": "硕人頎頎，衣锦褧衣。",
  "source": "待考"
 },
 {
  "char": "婵",
  "line": "盈盈一水间，脉脉不得语。",
  "source": "古诗十九首·《迢迢牵牛星》"
 },
 {
  "char": "戟",
  "line": "朱雀桥边野草花，乌衣巷口夕阳斜。",
  "source": "待考"
 },
 {
  "char": "跎",
  "line": "少年负壮气，奋烈自有时。但使中圣人，尊酒乐无涯。",
  "source": "待考"
 },
 {
  "char": "筵",
  "line": "金樽清酒斗十千，玉盘珍羞直万钱。",
  "source": "待考"
 },
 {
  "char": "觞",
  "line": "人生得意须尽欢，莫使金樽空对月。",
  "source": "待考"
 },
 {
  "char": "雉",
  "line": "关关雎鸠，在河之洲。窈窕淑女，君子好逑。",
  "source": "诗经·《国风·周南·关雎》"
 },
 {
  "char": "酹",
  "line": "人生得意须尽欢，莫使金樽空对月。",
  "source": "待考"
 },
 {
  "char": "樽",
  "line": "劝君更尽一杯酒，西出阳关无故人。",
  "source": "王维·《送元二使安西》"
 },
 {
  "char": "樽",
  "line": "葡萄美酒夜光杯，欲饮琵琶马上催。",
  "source": "王翰·《凉州词》"
 },
 {
  "char": "蹉",
  "line": "少壮不努力，老大徒伤悲。",
  "source": "汉乐府·《长歌行》"
 },
 {
  "char": "壑",
  "line": "两岸青山相对出，孤帆一片日边来。",
  "source": "李白·《望天门山》"
 },
 {
  "char": "壑",
  "line": "山重水复疑无路，柳暗花明又一村。",
  "source": "陆游·《游山西村》"
 },
 {
  "char": "𦭜",
  "line": "字字看来皆是血，十年辛苦不寻常。",
  "source": "待考"
 },
 {
  "char": "㭕",
  "line": "曲径通幽处，禅房花木深。",
  "source": "常建·《题破山寺后禅院》"
 },
 {
  "char": "涄",
  "line": "娉娉袅袅十三余，豆蔻梢头二月初。",
  "source": "待考"
 },
 {
  "char": "勚",
  "line": "莫知我勩，不遑启居。",
  "source": "待考"
 },
 {
  "char": "婳",
  "line": "静女其姝，俟我于城隅。",
  "source": "诗经·《邶风·静女》"
 }
]